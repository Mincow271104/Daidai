{
  "expo": {
    "name": "DaiDai 呆呆鸚",
    "slug": "daidai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daidai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DaiDai cần mic để nghe sư phụ nói thuật ngữ tiếng Anh rồi dạy lại tiếng Đài Loan!",
        "NSCameraUsageDescription": "DaiDai không cần camera."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0A1E"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "package": "com.daidai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      "expo-sqlite",
      "expo-audio"
    ]
  }
}
