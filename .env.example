# Optional local speech server URL. Use an address reachable from the physical phone.
EXPO_PUBLIC_LOCAL_AI_URL=

# Optional developer-only Gemini key.
# EXPO_PUBLIC_* values are embedded into the client bundle. Do not use a shared
# production secret here or publish an APK containing a private shared key.
# For ordinary use, configure a personal API key in the app's settings.
EXPO_PUBLIC_GEMINI_API_KEY=
